# Copy this file to .env for local use. Never commit the real cookie.
GLADOS_COOKIE=koa:sess=replace-me; koa:sess.sig=replace-me

# These defaults can be overridden if GLaDOS changes its internal API.
GLADOS_BASE_URL=https://glados.rocks
GLADOS_CHECKIN_PATH=/api/user/checkin
GLADOS_CHECKIN_TOKEN=glados.one

# Request timeout, retry count for transient failures, and optional random delay.
GLADOS_TIMEOUT=15
GLADOS_RETRIES=2
GLADOS_JITTER_SECONDS=0

