# Copy this file to .env for local use. Never commit the real cookie.
# Copy the complete Cookie request header from the signed-in check-in request.
GLADOS_COOKIE=session-cookie-name=replace-me

# These defaults can be overridden if GLaDOS changes its internal API.
GLADOS_BASE_URL=https://glados.rocks
GLADOS_CHECKIN_PATH=/api/user/checkin
# Empty means "use the hostname from GLADOS_BASE_URL", matching the current web app.
GLADOS_CHECKIN_TOKEN=
# For new gld sessions, copy User-Agent from the same browser request used above.
GLADOS_USER_AGENT=

# Request timeout, retry count for transient failures, and optional random delay.
GLADOS_TIMEOUT=15
GLADOS_RETRIES=2
GLADOS_JITTER_SECONDS=0
